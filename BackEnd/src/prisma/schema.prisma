generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserThemes {
  LIGHT     @map("Light")
  DARK      @map("Dark")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  cpf          String   @unique
  balance      Decimal  @db.Decimal(15, 2) @default(0) @map("balance")        
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  theme        UserThemes @default(LIGHT)

  transactionsSent     Transaction[] @relation("SenderRelation")
  transactionsReceived Transaction[] @relation("ReceiverRelation")

  cardUser     CreditCards[] @relation("UserRelation")

  billUser     Bills[] @relation("UserRelationBill")

  invoiceUser     Invoices[] @relation("UserRelationInvoice")

  @@map("users")
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  amount       Decimal  @db.Decimal(15, 2) @default(0)
  cpf          String
  createdAt    DateTime @default(now()) @map("created_at")
  description  String   @db.VarChar(200)
  type         String   @default("transaction") 

  senderId     String   @map("sender_id") @db.Uuid
  sender       User     @relation("SenderRelation", fields: [senderId], references: [id])

  receiverId   String   @map("receiver_id") @db.Uuid
  receiver     User     @relation("ReceiverRelation", fields: [receiverId], references: [id])


  @@map("transactions")
}

enum StatusCartao {
  ATIVO
  BLOQUEADO
}

model CreditCards {
  idCard       String   @map("id_card") @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(30)
  cardNumber   String   @map("card_number") @unique
  cvv          String   @db.VarChar(3)
  validateDate    DateTime    @map("validate_date")
  totalLimit   Decimal    @map("total_limit") @db.Decimal(10,2)
  freeLimit    Decimal    @map("free_limit") @db.Decimal(10,2)
  status       StatusCartao     @default(ATIVO)
  main         Boolean    @default(false)
  theme        Int        @default(0)

  userId       String     @map("user_id") @db.Uuid
  user         User       @relation("UserRelation", fields: [userId], references: [id])

  billCard     Bills[] @relation("CardBills")

  invoiceCard     Invoices[] @relation("CardInvoice")

  @@map("cards")
}

enum StatusBill {
  EM_ABERTO @map("Em Aberto")
  PAGO      @map("Pago")
  CANCELADO @map("Cancelado")
  FATURADO  @map("Faturado")
}

model Bills {
  billId       String   @map("bill_id") @id @default(uuid()) @db.Uuid
  billName     String   @map("bill_name") @db.VarChar(50)
  biller       String   @map("biller") @db.VarChar(50)
  description      String   @db.VarChar(50)
  dueDate      DateTime   @map("due_date")
  createdAt    DateTime   @map("created_at") @default(now())
  updatedAt    DateTime @updatedAt @map("updated_at")
  status       StatusBill    @default(EM_ABERTO)
  value        Decimal    @db.Decimal(10,2)
  type         String   @default("bills")

  userId       String   @map("user_id") @db.Uuid
  user         User     @relation("UserRelationBill", fields: [userId], references: [id])

  cardId String?      @map("card_id") @db.Uuid
  card   CreditCards? @relation("CardBills", fields: [cardId], references: [idCard])

  @@map("bills")
}

enum StatusInvoice {
  EM_ABERTO @map("Em Aberto")
  PAGO      @map("Pago")
  CANCELADO @map("Cancelado")
}

model Invoices {
  invoiceId    String   @map("invoice_id") @id @default(uuid()) @db.Uuid
  invoiceName  String   @map("invoice_name") @db.VarChar(30)
  totalAmount  Decimal  @db.Decimal(10,2)
  totalPredicted  Decimal   @db.Decimal(10,2) @default(0.00)
  totalPaid    Decimal  @db.Decimal(10,2) @default(0.00)
  dueDate      DateTime   @map("due_date")
  itens        Json
  createdAt    DateTime   @map("created_at") @default(now())
  updatedAt    DateTime @updatedAt @map("updated_at")
  status       StatusInvoice  @default(EM_ABERTO)

  userId       String   @map("user_id") @db.Uuid
  user         User     @relation("UserRelationInvoice", fields: [userId], references: [id])

  cardId       String   @map("card_id") @db.Uuid
  card         CreditCards   @relation("CardInvoice", fields: [cardId], references: [idCard])

  @@map("invoices")
}