generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  cpf          String   @unique
  balance      Decimal  @db.Decimal(15, 2) @default(0) @map("balance")        
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transactionsSent     Transaction[] @relation("SenderRelation")
  transactionsReceived Transaction[] @relation("ReceiverRelation")

  cardUser     CreditCards[] @relation("UserRelation")

  @@map("users")
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  amount       Decimal  @db.Decimal(15, 2) @default(0)
  cpf          String
  createdAt    DateTime @default(now()) @map("created_at")
  description  String   @db.Char(200)
  type         String   @default("transaction") 

  senderId     String   @map("sender_id") @db.Uuid
  sender       User     @relation("SenderRelation", fields: [senderId], references: [id])

  receiverId   String   @map("receiver_id") @db.Uuid
  receiver     User     @relation("ReceiverRelation", fields: [receiverId], references: [id])


  @@map("transactions")
}

enum StatusCartao {
  ATIVO
  BLOQUEADO
}

model CreditCards {
  idCard       String   @map("id_card") @id @default(uuid()) @db.Uuid
  cardNumber   String   @map("card_number") @unique
  cvv          Int      @db.Integer
  validateDate    String    @map("validate_date")
  totalLimit   Decimal    @map("total_limit") @db.Decimal(10,2)
  freeLimit    Decimal    @map("free_limit") @db.Decimal(10,2)
  status       StatusCartao     @default(ATIVO)

  userId       String     @map("user_id") @db.Uuid
  user         User       @relation("UserRelation", fields: [userId], references: [id])


  @@map("cards")
}